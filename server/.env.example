NODE_ENV=development
PORT=4000

# Local docker-compose Mongo
MONGODB_URI=mongodb://localhost:27017/provisio

# Frontend origin allowed to make credentialed requests (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign JWTs — generate a real random value for any non-local environment
JWT_SECRET=dev-only-secret-change-me

# Optional overrides for `npm run seed:admin` (defaults shown — change the
# password before running this against anything but a local dev database)
SEED_ADMIN_EMAIL=admin@provisio.local
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Provisio Admin
